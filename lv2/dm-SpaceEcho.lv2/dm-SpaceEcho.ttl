@prefix doap:  	<http://usefulinc.com/ns/doap#> .
@prefix foaf:  	<http://xmlns.com/foaf/0.1/> .
@prefix lv2:   	<http://lv2plug.in/ns/lv2core#> .
@prefix pg:    	<http://lv2plug.in/ns/ext/port-groups#> .
@prefix rdf:   	<http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  	<http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: 	<http://lv2plug.in/ns/extensions/units#> .
@prefix pprops:	<http://lv2plug.in/ns/ext/port-props#> .
@prefix mod:   	<http://moddevices.com/ns/mod#> .

<https://github.com/davemollen/dm-SpaceEcho>
	a lv2:Plugin , lv2:DelayPlugin , lv2:ReverbPlugin , mod:DelayPlugin , mod:ReverbPlugin ;
	lv2:project <http://lv2plug.in/ns/lv2> ;
	doap:name "dm-SpaceEcho" ;
	doap:license "GPLv3" ;
	doap:maintainer [
		foaf:name "Dave Mollen" ;
		foaf:homepage <https://github.com/davemollen/dm-SpaceEcho> ;
	] ;
	mod:brand "DM" ;
	mod:label "SpaceEcho" ;
	lv2:minorVersion 1 ;
	lv2:microVersion 2 ;
	rdfs:comment """
A delay and reverb effect inspired by the Space Echo.
""" ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 0 ;
		lv2:symbol "input" ;
		lv2:name "Input" ;
		lv2:default 0.0 ;
		lv2:minimum -32.0 ;
		lv2:maximum 32.0 ;
		units:unit units:db ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_delay> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 1 ;
		lv2:symbol "time_link" ;
		lv2:name "Time Link" ;
		lv2:portProperty lv2:integer, lv2:toggled;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_delay> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 2 ;
		lv2:symbol "time_left" ;
		lv2:name "Time Left" ;
		lv2:portProperty pprops:logarithmic, mod:tempoRelatedDynamicScalePoints ;
		lv2:default 250.0 ;
		lv2:minimum 1.0 ;
		lv2:maximum 2500.0 ;
		units:unit units:ms ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_delay> ;
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 3;
		lv2:symbol "time_right" ;
		lv2:name "Time Right" ;
		lv2:portProperty pprops:logarithmic, mod:tempoRelatedDynamicScalePoints;
		lv2:default 250.0 ;
		lv2:minimum 1.0 ;
		lv2:maximum 2500.0 ;
		units:unit units:ms ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_delay> ;
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 4 ;
		lv2:symbol "feedback" ;
		lv2:name "Feedback" ;
		lv2:default 50.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 150.0 ;
		units:unit units:pc ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_delay> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 5 ;
		lv2:symbol "hold" ;
		lv2:name "Hold" ;
		lv2:portProperty lv2:integer, lv2:toggled;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_delay> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 6 ;
		lv2:symbol "wow_and_flutter" ;
		lv2:name "Wow & Flutter" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_delay> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 7 ;
		lv2:symbol "channel_mode" ;
		lv2:name "Channel Mode" ;
		lv2:portProperty lv2:integer;
		lv2:portProperty lv2:enumeration ;
		lv2:default 1 ;
		lv2:minimum 1 ;
		lv2:maximum 2 ;
		lv2:scalePoint [rdfs:label "stereo"; rdf:value 1];
		lv2:scalePoint [rdfs:label "pingpong"; rdf:value 2];
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_delay> ;
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 8 ;
		lv2:symbol "time_mode" ;
		lv2:name "Time Mode" ;
		lv2:portProperty lv2:integer;
		lv2:portProperty lv2:enumeration ;
		lv2:default 1 ;
		lv2:minimum 1 ;
		lv2:maximum 2 ;
		lv2:scalePoint [rdfs:label "repitch"; rdf:value 1];
		lv2:scalePoint [rdfs:label "fade"; rdf:value 2];
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_delay> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 9 ;
		lv2:symbol "highpass_freq" ;
		lv2:name "Highpass Freq" ;
		lv2:portProperty pprops:logarithmic ;
		lv2:default 20.0 ;
		lv2:minimum 20.0 ;
		lv2:maximum 20000.0 ;
		units:unit units:hz ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_filter> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 10 ;
		lv2:symbol "highpass_res" ;
		lv2:name "Highpass Res" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_filter> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 11 ;
		lv2:symbol "lowpass_freq" ;
		lv2:name "Lowpass Freq" ;
		lv2:portProperty pprops:logarithmic ;
		lv2:default 20000.0 ;
		lv2:minimum 20.0 ;
		lv2:maximum 20000.0 ;
		units:unit units:hz ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_filter> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 12 ;
		lv2:symbol "lowpass_res" ;
		lv2:name "Lowpass Res" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_filter> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 13 ;
		lv2:symbol "reverb" ;
		lv2:name "Reverb" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_reverb> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 14 ;
		lv2:symbol "decay" ;
		lv2:name "Decay" ;
		lv2:default 75.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_reverb> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 15 ;
		lv2:symbol "stereo" ;
		lv2:name "Stereo" ;
		lv2:default 100.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_output> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 16 ;
		lv2:symbol "duck" ;
		lv2:name "Duck" ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_output> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 17 ;
		lv2:symbol "output" ;
		lv2:name "Output" ;
		lv2:default 0.0 ;
		lv2:minimum -70.0 ;
		lv2:maximum 12.0 ;
		units:unit units:db ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_output> ;
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 18 ;
		lv2:symbol "mix" ;
		lv2:name "Mix" ;
		lv2:default 50.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 100.0 ;
		units:unit units:pc ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_output>
	], [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 19 ;
		lv2:symbol "limiter" ;
		lv2:name "Limiter" ;
		lv2:portProperty lv2:integer, lv2:toggled;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		pg:group <https://github.com/davemollen/dm-SpaceEcho#group_output>
	], [
		a lv2:AudioPort, lv2:InputPort ;
		lv2:index 20 ;
		lv2:symbol "in_left" ;
		lv2:name "In left" ;
	], [
		a lv2:AudioPort, lv2:InputPort ;
		lv2:index 21 ;
		lv2:symbol "in_right" ;
		lv2:name "In right" ;
	] , [
		a lv2:AudioPort, lv2:OutputPort ;
		lv2:index 22 ;
		lv2:symbol "out_left" ;
		lv2:name "Out left" ;
	] , [
		a lv2:AudioPort, lv2:OutputPort ;
		lv2:index 23 ;
		lv2:symbol "out_right" ;
		lv2:name "Out right" ;
	] , [
		a lv2:InputPort, lv2:ControlPort ;
		lv2:index 24 ;
		lv2:symbol "enabled" ;
		lv2:name "Enabled" ;
		lv2:designation lv2:enabled ;
		lv2:portProperty lv2:integer, lv2:toggled ;
		lv2:default 1 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
	] .

# Port groups
<https://github.com/davemollen/dm-SpaceEcho#group_delay>
	a pg:InputGroup ;
	lv2:symbol "delay" ;
	lv2:name "Delay" ;
	lv2:index 0 .

<https://github.com/davemollen/dm-SpaceEcho#group_filter>
	a pg:InputGroup ;
	lv2:symbol "filter" ;
	lv2:name "Filter" ;
	lv2:index 1 .

<https://github.com/davemollen/dm-SpaceEcho#group_reverb>
	a pg:InputGroup ;
	lv2:symbol "reverb" ;
	lv2:name "Reverb" ;
	lv2:index 2 .

<https://github.com/davemollen/dm-SpaceEcho#group_output>
	a pg:InputGroup ;
	lv2:symbol "output" ;
	lv2:name "Output" ;
	lv2:index 3 .
